#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <17 16>;
            bindings = <&kp LANGUAGE_2>;
        };

        key2 {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <13 12>;
        };

        m {
            bindings = <&mkp MB3>;
            key-positions = <>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q          &kp W         &kp E               &kp R                   &kp T        &kp Y        &kp U           &kp I                    &kp O              &kp P
&kp A          &kp S         &kp D               &kp F                   &kp G        &kp H        &kp J           &kp K                    &mkp LCLK          &mkp RCLK
&kp Z          &kp X         &kp C               &kp V                   &kp B        &kp N        &kp M           &kp L                    &mt AT_SIGN MINUS  &mt RIGHT_BRACKET LEFT_BRACKET
&kp BACKSPACE  &kp LEFT_ALT  &mt LEFT_SHIFT TAB  &mt LEFT_CONTROL LC(Z)  &lt 1 SPACE  &lt 2 ENTER  &lt 3 RA(LEFT)  &mt TAB RA(RIGHT_ARROW)  &kp RIGHT_WIN      &mt PERIOD COMMA
            >;
        };

        layer1 {
            label = "NUMBER";
            bindings = <
&mt LS(LC(N)) LS(O)       &mt LC(G) LS(I)          &mt LS(MINUS) MINUS    &mt LS(U) LS(Y)              &mt LC(LA(G)) LS(H)     &kp MINUS              &mkp MCLK                &kp UP         &trans     &bt BT_CLR
&mt M LC(Z)               &mt H LC(Y)              &mt LC(T) LC(MINUS)    &mt LC(LS(T)) LC(SEMICOLON)  &mt SLASH LC(NUMBER_0)  &kp PLUS               &kp LEFT                 &kp DOWN       &kp RIGHT  &trans
&mt NUMBER_5 NUMBER_0     &mt NUMBER_6 NUMBER_1    &mt NUMBER_7 NUMBER_2  &mt NUMBER_8 NUMBER_3        &mt NUMBER_9 NUMBER_4   &kp ASTRK              &kp SLASH                &kp LBKT       &kp RBKT   &trans
&mt EXCLAMATION QUESTION  &mt LC(LA(LS(K))) LC(K)  &trans                 &trans                       &trans                  &mt RIGHT_SHIFT ENTER  &mt RIGHT_CONTROL SPACE  &kp RIGHT_ALT  &trans     &trans
            >;
        };

        layer2 {
            bindings = <
&kp AT_SIGN    &kp CARET         &kp SEMICOLON     &kp COLON               &kp SLASH             &kp BACKSLASH  &kp SINGLE_QUOTE      &kp DOUBLE_QUOTES      &kp PERCENT     &kp COMMA
&kp LESS_THAN  &kp GREATER_THAN  &kp LEFT_BRACKET  &kp RIGHT_BRACKET       &kp UNDER             &kp DOT        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACE  &kp RIGHT_BRACE
&kp HASH       &kp EXCLAMATION   &kp QUESTION      &kp TILDE               &kp PIPE              &kp ASTRK      &kp PLUS              &kp MINUS              &kp EQUAL       &mt INT_YEN DOLLAR
&kp BACKSPACE  &trans            &kp LEFT_ALT      &mt LEFT_CONTROL SPACE  &mt LEFT_SHIFT ENTER  &trans         &trans                &trans                 &trans          &kp AMPERSAND
            >;
        };

        layer3 {
            label = "FUNCTION";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3            &bt BT_SEL 4          &kp F1   &kp F2   &kp F3  &kp F4  &kp F5
&trans        &trans        &trans        &trans                  &bt BT_CLR            &kp F6   &kp F7   &kp F8  &kp F9  &kp F10
&trans        &trans        &trans        &trans                  &bt BT_CLR_ALL        &kp F11  &kp F12  &trans  &trans  &trans
&trans        &trans        &kp LEFT_ALT  &mt LEFT_CONTROL SPACE  &mt LEFT_SHIFT ENTER  &trans   &trans   &trans  &trans  &trans
            >;
        };

        layer4 {
            label = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
